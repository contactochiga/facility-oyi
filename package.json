    "@capacitor/ios": "^6.1.0",
    "@types/node": "^20.11.30",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.7.0",
    "eslint-config-next": "15.5.9",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5"
  }
