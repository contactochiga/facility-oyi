    "@tanstack/react-table": "^8.20.5",
    "@vercel/analytics": "^1.5.0",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.16",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.474.0",
    "next": "15.5.19",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.3.0",
    "recharts": "^2.13.3",
    "socket.io-client": "^4.8.3",
    "zustand": "^4.5.5"
